{
  "schema_version": "prii.gui-capability/v1",
  "repository": "jotaele44/ovnis-pr",
  "policy": {
    "mode": "ratchet",
    "baseline": ".federation/gui-parity-baseline.json",
    "require_discoverable_gui": true,
    "require_e2e": true,
    "terminal_free_user_path": true
  },
  "discovery": {
    "backend_roots": [
      "server/backend"
    ],
    "production_roots": [
      "maintenance",
      "desktop"
    ],
    "analysis_roots": [
      "scripts"
    ],
    "frontend_roots": [
      "dashboard/src"
    ],
    "frontend_capability_roots": [
      "dashboard/src/pages"
    ],
    "frontend_api_roots": [
      "dashboard/src/lib/api.js"
    ],
    "route_files": [
      "dashboard/src/App.jsx"
    ],
    "navigation_files": [
      "dashboard/src/pages/Dashboard.jsx"
    ],
    "implicit_routes": [],
    "exclude": [
      "**/tests/**",
      "**/*.test.*",
      "**/*.spec.*",
      "**/components/ui/**",
      "scripts/check_gui_parity.py"
    ]
  },
  "capabilities": [
    {
      "id": "case-research-dashboard",
      "classification": "analysis",
      "status": "active",
      "requires_terminal": false,
      "backend": {
        "files": [
          "server/backend/main.py"
        ],
        "endpoints": [
          "GET /cases",
          "GET /cases/{case_id}",
          "GET /candidates",
          "GET /geojson",
          "GET /stats",
          "GET /search"
        ]
      },
      "frontend": {
        "routes": [
          "/"
        ],
        "e2e_routes": [
          "/"
        ],
        "components": [
          "dashboard/src/lib/api.js",
          "dashboard/src/pages/Dashboard.jsx",
          "dashboard/src/components/CaseGrid.jsx",
          "dashboard/src/components/CaseDetail.jsx",
          "dashboard/src/components/CaseMap.jsx",
          "dashboard/src/components/CandidateReview.jsx",
          "dashboard/src/components/StatsPanel.jsx"
        ],
        "discoverability": [
          "dashboard/src/pages/Dashboard.jsx"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_validate_case_ledgers.py",
          "tests/test_import_candidates.py",
          "tests/test_promote_candidate.py"
        ],
        "contract": [
          "tests/test_gui_parity.py"
        ],
        "e2e": [
          "dashboard/tests/gui-parity.spec.mjs"
        ]
      }
    },
    {
      "id": "service-health",
      "classification": "internal",
      "status": "active",
      "requires_terminal": false,
      "rationale": "Health probing supports launch and CI readiness rather than a separate user workflow.",
      "backend": {
        "files": [
          "server/backend/main.py"
        ],
        "endpoints": [
          "GET /health"
        ]
      },
      "tests": {
        "backend": [
          "tests/test_server_smoke.py"
        ]
      }
    }
  ],
  "exceptions": []
}
